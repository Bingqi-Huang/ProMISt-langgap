(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the black bowl to the left of the plate and place it on the plate)
    (:regions
      (plate_region
          (:target main_table)
          (:ranges (
              (0.05 0.19 0.07 0.21)
            )
          )
      )
      (ramekin_region
          (:target main_table)
          (:ranges (
              (-0.21 0.19 -0.19 0.21)
            )
          )
      )
      (cabinet_region
          (:target main_table)
          (:ranges (
              (0.02 -0.28 0.04 -0.26)
            )
          )
          (:yaw_rotation (
              (2.6613777765410678 2.7242096296128633)
            )
          )
      )
      (stove_region
          (:target main_table)
          (:ranges (
              (-0.42 -0.15 -0.4 -0.13)
            )
          )
      )
      (top_region
          (:target wooden_cabinet_1)
      )
      (middle_region
          (:target wooden_cabinet_1)
      )
      (bottom_region
          (:target wooden_cabinet_1)
      )
      (top_side
          (:target wooden_cabinet_1)
      )
      (cook_region
          (:target flat_stove_1)
      )
      (bowl1_region
          (:target main_table)
          (:ranges (
              (-0.1480 0.2120 -0.0920 0.2680)
            )
          )
      )
      (bowl2_region
          (:target main_table)
          (:ranges (
              (0.1320 0.1120 0.1880 0.1680)
            )
          )
      )
      (bowl3_region
          (:target main_table)
          (:ranges (
              (0.1120 0.2720 0.1680 0.3280)
            )
          )
      )
    )

  (:fixtures
    main_table - table
    wooden_cabinet_1 - wooden_cabinet
    flat_stove_1 - flat_stove
  )

  (:objects
    akita_black_bowl_1 akita_black_bowl_2 akita_black_bowl_3 - akita_black_bowl
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    plate_1 - plate
  )

  (:obj_of_interest
    akita_black_bowl_1
    plate_1
  )

  (:init
    (On akita_black_bowl_1 main_table_bowl1_region)
    (On akita_black_bowl_2 main_table_bowl2_region)
    (On akita_black_bowl_3 main_table_bowl3_region)
    (On plate_1 main_table_plate_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_ramekin_region)
    (On wooden_cabinet_1 main_table_cabinet_region)
    (On flat_stove_1 main_table_stove_region)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_1))
  )
)
